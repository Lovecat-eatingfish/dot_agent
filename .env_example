API_KEY=
MODEL=
BASE_URL=

# Optional: LLM fallback models (comma-separated, tried in order on primary failure)
MODEL_FALLBACKS=

# Optional: LLM request settings
DOT_REQUEST_TIMEOUT=120
DOT_MAX_RETRIES=3

# Optional: Web search (only needed for searchAgent)
TAVILY_API_KEY=

# Optional: Logging (DEBUG / INFO / WARNING / ERROR / CRITICAL)
DOT_LOG_LEVEL=INFO

# Optional: Trace (1=on, 0=off)
DOT_TRACE_ENABLED=1
