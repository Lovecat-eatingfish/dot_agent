# Required: LLM provider configuration
API_KEY=
MODEL=
BASE_URL=

# Optional: Web search (only needed for searchAgent)
TAVILY_API_KEY=

# Optional: Context management
MOKIO_CONTEXT_TOKEN_LIMIT=400000

# Optional: BashTool configuration
MOKIO_BASH_DEFAULT_TIMEOUT_SECONDS=120
MOKIO_BASH_MAX_TIMEOUT_SECONDS=600
MOKIO_BASH_MAX_OUTPUT_CHARS=6000
MOKIO_BASH_ENV_FILE=

# Optional: Checkpoint mode (light / strict / off)
MOKIO_CHECKPOINT_MODE=light

# Optional: Trace mode (on / off)
MOKIO_TRACE_MODE=on

# Optional: Logging (DEBUG / INFO / WARNING / ERROR / CRITICAL)
MOKIO_LOG_LEVEL=WARNING
# MOKIO_LOG_FILE=/path/to/mokioclaw.log
